{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "albor-hoja-rooms",
  "main": "src/index.ts",
  // Newest date accepted by the workerd bundled with Wrangler 4.128.
  "compatibility_date": "2026-09-07",
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOM",
        "class_name": "Room"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Room"]
    }
  ]
}
